APP_ENV=local
APP_NAME=Magento Product Automation
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

DATABASE_URL=postgresql+psycopg://catalog:catalog@postgres:5432/catalog
REDIS_URL=redis://redis:6379/0

JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720

MAGENTO_BASE_URL=https://www.example.com
MAGENTO_API_TOKEN=
MAGENTO_STORE_VIEW=admin
MAGENTO_DEFAULT_ATTRIBUTE_SET_ID=4
MAGENTO_DEFAULT_TAX_CLASS_ID=2
MAGENTO_DEFAULT_WEBSITE=base

MEDIA_BASE_PATH=/mnt/media
MEDIA_PUBLIC_BASE_URL=https://imgcdn1.gempundit.com/media/catalog/product

UPLOAD_MAX_FILE_MB=100
DEFAULT_PRODUCT_STATUS=2
DEFAULT_PRODUCT_VISIBILITY=4
DEFAULT_PRODUCT_TYPE=simple
DEFAULT_PRODUCT_WEIGHT=0.15
